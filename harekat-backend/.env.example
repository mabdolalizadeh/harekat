NODE_ENV=development
JWT_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRY=7d
USER_JWT_EXPIRY=7d
PORT=3000

# CORS Origins (comma-separated list of allowed origins)
# For production: https://schoolharekat.ir,https://www.schoolharekat.ir,https://admin.schoolharekat.ir,https://dashboard.schoolharekat.ir
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://schoolharekat.ir,https://www.schoolharekat.ir,https://admin.schoolharekat.ir,https://dashboard.schoolharekat.ir

# Production hostnames for backend static SPA selector
ADMIN_HOSTNAME=admin.schoolharekat.ir
DASHBOARD_HOSTNAME=dashboard.schoolharekat.ir

# OTP Authentication System Configuration
# Active mode: 'mock' (logs OTP to console for dev/test) or 'smsir' (sends real SMS via SMS.ir)
OTP_MODE=mock

# SMS.ir REST API v1 Configuration (Required only when OTP_MODE=smsir)
# Obtain your API Key from the SMS.ir developer panel (کلید وب‌سرویس)
SMSIR_API_KEY=your_smsir_api_key_here
# Template ID defined in SMS.ir Fast Send / Verify panel (شناسه قالب ارسال سریع)
SMSIR_TEMPLATE_ID=123456
# Parameter variable name defined in the SMS.ir template (without '#' symbols, e.g. 'Code')
SMSIR_TEMPLATE_PARAM_NAME=Code
# SMS.ir REST API Base URL
SMSIR_BASE_URL=https://api.sms.ir

# OTP Security & Rate Limiting (in seconds / counts)
OTP_EXPIRES_IN_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# Payment Gateway Configuration
# Active gateway: 'zibal' or 'mock' (default: mock in dev, zibal in production)
PAYMENT_GATEWAY=mock

# Zibal IPG Configuration
# Use 'zibal' for testing/sandbox mode or your official Merchant ID for production
ZIBAL_MERCHANT=zibal

# Zibal IPG Callback URL
# Note: schoolharekat.ir has NO api subdomain; API is at domain/api
# Production: https://schoolharekat.ir/api/v1/payments/zibal/callback
# Local dev:  http://localhost:3000/api/v1/payments/zibal/callback
ZIBAL_CALLBACK_URL=https://schoolharekat.ir/api/v1/payments/zibal/callback

# Frontend & Backend Base URLs
BACKEND_BASE_URL=https://schoolharekat.ir
DASHBOARD_URL=https://dashboard.schoolharekat.ir
